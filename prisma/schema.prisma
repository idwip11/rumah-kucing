generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cats                   Cat[]
  chatMessages           ChatMessage[]
  orders                 Order[]
  recommendationFeedback RecommendationFeedback[]
  breedFavorites         BreedFavorite[]
  breedViews             BreedView[]

  @@map("users")
}

// ─────────────────────────────────────────────
// ADMIN USERS
// ─────────────────────────────────────────────
model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique @db.VarChar(80)
  passwordHash String   @map("password_hash") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("admin_users")
}

// ─────────────────────────────────────────────
// CAT BREEDS (master / seed data)
// ─────────────────────────────────────────────
model CatBreed {
  id                     String    @id @default(uuid())
  slug                   String    @unique @db.VarChar(80)
  name                   String    @unique @db.VarChar(80)
  origin                 String?   @db.VarChar(80)
  imageSrc               String?   @map("image_src")
  profileSummary         String?   @map("profile_summary") @db.Text
  foodType               String?   @map("food_type") @db.Text
  kittenPriceLabel       String?   @map("kitten_price_label") @db.VarChar(60)
  monthlyCareLabel       String?   @map("monthly_care_label") @db.VarChar(60)
  careLevel              String?   @map("care_level") @db.VarChar(40)
  availability           String?   @db.VarChar(60)
  matchLabel             String?   @map("match_label") @db.VarChar(120)
  alternativeNames       Json?     @map("alternative_names") @db.JsonB
  shortDescription       String?   @map("short_description") @db.Text
  backdropImageSrc       String?   @map("backdrop_image_src")
  history                String?   @db.Text
  personalityDescription String?   @map("personality_description") @db.Text
  sizeLabel              String?   @map("size_label") @db.VarChar(80)
  maleWeightRange        String?   @map("male_weight_range") @db.VarChar(80)
  femaleWeightRange      String?   @map("female_weight_range") @db.VarChar(80)
  lifeExpectancy         String?   @map("life_expectancy") @db.VarChar(80)
  coatLength             String?   @map("coat_length") @db.VarChar(80)
  coatPatterns           String?   @map("coat_patterns") @db.Text
  activityLevel          String?   @map("activity_level") @db.VarChar(80)
  vocalLevel             String?   @map("vocal_level") @db.VarChar(80)
  indoorFit              String?   @map("indoor_fit") @db.VarChar(80)
  beginnerFitScore       Int?      @map("beginner_fit_score")
  activityScore          Int?      @map("activity_score")
  friendlinessScore      Int?      @map("friendliness_score")
  groomingScore          Int?      @map("grooming_score")
  vocalScore             Int?      @map("vocal_score")
  adaptabilityScore      Int?      @map("adaptability_score")
  childFriendlyScore     Int?      @map("child_friendly_score")
  petFriendlyScore       Int?      @map("pet_friendly_score")
  sourceNotes            String?   @map("source_notes") @db.Text
  contentUpdatedAt       DateTime? @map("content_updated_at")
  commercialUpdatedAt    DateTime? @map("commercial_updated_at")
  viewCount              Int       @default(0) @map("view_count")
  isPublished            Boolean   @default(true) @map("is_published")
  isFeatured             Boolean   @default(false) @map("is_featured")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  characteristics BreedCharacteristic[]
  careGuide       BreedCareGuide?
  nutritionGuide  BreedNutritionGuide?
  healthNotes     BreedHealthNote[]
  costEstimates   BreedCostEstimate[]
  galleryImages   BreedGalleryImage[]
  colorPatterns   BreedColorPattern[]
  similarBreeds   BreedSimilar[]        @relation("BreedSimilarSource")
  similarTo       BreedSimilar[]        @relation("BreedSimilarTarget")
  suitabilities   BreedSuitability[]
  favorites       BreedFavorite[]
  views           BreedView[]
  cats            Cat[]
  articles        Article[]

  @@map("cat_breeds")
}

model BreedCharacteristic {
  id      String @id @default(uuid())
  breedId String @map("breed_id")
  label   String @db.VarChar(80)

  breed CatBreed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@map("breed_characteristics")
}

enum BreedGalleryImageType {
  main
  backdrop
  face
  full_body
  kitten
  adult
  color_variant
  other
}

enum BreedSuitabilityType {
  good_for
  consider_if
}

enum BreedFavoriteListType {
  favorite
  learn_later
  adoption_consideration
  had_before
}

model BreedCareGuide {
  id                String   @id @default(uuid())
  breedId           String   @unique @map("breed_id")
  brushingFrequency String?  @map("brushing_frequency") @db.Text
  bathing           String?  @db.Text
  eyeCare           String?  @map("eye_care") @db.Text
  earCare           String?  @map("ear_care") @db.Text
  nailCare          String?  @map("nail_care") @db.Text
  dentalCare        String?  @map("dental_care") @db.Text
  sheddingLevel     String?  @map("shedding_level") @db.VarChar(80)
  hairballRisk      String?  @map("hairball_risk") @db.VarChar(80)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  breed CatBreed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@map("breed_care_guides")
}

model BreedNutritionGuide {
  id             String   @id @default(uuid())
  breedId        String   @unique @map("breed_id")
  lifeStageNotes String?  @map("life_stage_notes") @db.Text
  proteinNotes   String?  @map("protein_notes") @db.Text
  hydrationNotes String?  @map("hydration_notes") @db.Text
  portionNotes   String?  @map("portion_notes") @db.Text
  obesityRisk    String?  @map("obesity_risk") @db.VarChar(80)
  specialNeeds   String?  @map("special_needs") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  breed CatBreed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@map("breed_nutrition_guides")
}

model BreedHealthNote {
  id             String   @id @default(uuid())
  breedId        String   @map("breed_id")
  title          String   @db.VarChar(160)
  description    String   @db.Text
  severityLabel  String?  @map("severity_label") @db.VarChar(80)
  monitoringTips String?  @map("monitoring_tips") @db.Text
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  breed CatBreed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@index([breedId, sortOrder])
  @@map("breed_health_notes")
}

model BreedCostEstimate {
  id                  String   @id @default(uuid())
  breedId             String   @map("breed_id")
  initialCostLabel    String?  @map("initial_cost_label") @db.VarChar(120)
  monthlyCostLabel    String?  @map("monthly_cost_label") @db.VarChar(120)
  groomingCostLabel   String?  @map("grooming_cost_label") @db.VarChar(120)
  vaccineCheckupLabel String?  @map("vaccine_checkup_label") @db.VarChar(120)
  starterKitLabel     String?  @map("starter_kit_label") @db.VarChar(120)
  cityLabel           String?  @map("city_label") @db.VarChar(120)
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  breed CatBreed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@index([breedId, updatedAt(sort: Desc)])
  @@map("breed_cost_estimates")
}

model BreedGalleryImage {
  id             String                @id @default(uuid())
  breedId        String                @map("breed_id")
  colorPatternId String?               @map("color_pattern_id")
  url            String                @db.Text
  alt            String?               @db.VarChar(255)
  type           BreedGalleryImageType @default(other)
  credit         String?               @db.VarChar(160)
  sourceUrl      String?               @map("source_url") @db.VarChar(500)
  sortOrder      Int                   @default(0) @map("sort_order")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at")

  breed        CatBreed           @relation(fields: [breedId], references: [id], onDelete: Cascade)
  colorPattern BreedColorPattern? @relation(fields: [colorPatternId], references: [id], onDelete: SetNull)

  @@index([breedId, type, sortOrder])
  @@index([colorPatternId])
  @@map("breed_gallery_images")
}

model BreedColorPattern {
  id          String   @id @default(uuid())
  breedId     String   @map("breed_id")
  name        String   @db.VarChar(120)
  description String?  @db.Text
  imageUrl    String?  @map("image_url") @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  breed  CatBreed            @relation(fields: [breedId], references: [id], onDelete: Cascade)
  images BreedGalleryImage[]

  @@unique([breedId, name])
  @@index([breedId, sortOrder])
  @@map("breed_color_patterns")
}

model BreedSimilar {
  id             String   @id @default(uuid())
  breedId        String   @map("breed_id")
  similarBreedId String   @map("similar_breed_id")
  reason         String?  @db.Text
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  breed        CatBreed @relation("BreedSimilarSource", fields: [breedId], references: [id], onDelete: Cascade)
  similarBreed CatBreed @relation("BreedSimilarTarget", fields: [similarBreedId], references: [id], onDelete: Cascade)

  @@unique([breedId, similarBreedId])
  @@index([breedId, sortOrder])
  @@index([similarBreedId])
  @@map("breed_similars")
}

model BreedSuitability {
  id          String               @id @default(uuid())
  breedId     String               @map("breed_id")
  type        BreedSuitabilityType
  label       String               @db.VarChar(160)
  description String?              @db.Text
  sortOrder   Int                  @default(0) @map("sort_order")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at")

  breed CatBreed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@index([breedId, type, sortOrder])
  @@map("breed_suitabilities")
}

model BreedFavorite {
  id        String                @id @default(uuid())
  userId    String                @map("user_id")
  breedId   String                @map("breed_id")
  listType  BreedFavoriteListType @default(favorite) @map("list_type")
  createdAt DateTime              @default(now()) @map("created_at")

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  breed CatBreed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@unique([userId, breedId, listType])
  @@index([breedId])
  @@map("breed_favorites")
}

model BreedView {
  id        String   @id @default(uuid())
  breedId   String   @map("breed_id")
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id") @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")

  breed CatBreed @relation(fields: [breedId], references: [id], onDelete: Cascade)
  user  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([breedId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([sessionId])
  @@map("breed_views")
}

// ─────────────────────────────────────────────
// CATS (user's pet profiles)
// ─────────────────────────────────────────────
model Cat {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  breedId              String?   @map("breed_id")
  name                 String    @db.VarChar(80)
  ageLabel             String?   @map("age_label") @db.VarChar(40)
  estimatedDateOfBirth DateTime? @map("estimated_date_of_birth") @db.Date
  weightKg             Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  gender               String?   @db.VarChar(10) // "Betina" | "Jantan"
  sterilized           Boolean   @default(false)
  lifestyle            String?   @db.VarChar(40) // "Indoor" | "Outdoor" | "Indoor + balkon" | "Campuran"
  notes                String?   @db.Text
  photoUrl             String?   @map("photo_url") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  breed                  CatBreed?                @relation(fields: [breedId], references: [id], onDelete: SetNull)
  timelineEvents         TimelineEvent[]
  achievements           Achievement[]
  chatMessages           ChatMessage[]
  recommendationFeedback RecommendationFeedback[]

  @@index([userId])
  @@map("cats")
}

// ─────────────────────────────────────────────
// TIMELINE EVENTS
// ─────────────────────────────────────────────
enum TimelineStatus {
  Mendatang
  Tercatat
  Perawatan
  Memori
}

enum TimelineCategory {
  Vaksin
  Berat_badan   @map("Berat badan")
  Riwayat_sakit @map("Riwayat sakit")
  Makanan
  Grooming
  Momen_foto    @map("Momen foto")
  Lainnya
}

model TimelineEvent {
  id          String           @id @default(uuid())
  catId       String           @map("cat_id")
  title       String           @db.VarChar(160)
  eventDate   DateTime         @map("event_date") @db.Date
  description String?          @db.Text
  category    TimelineCategory @default(Lainnya)
  status      TimelineStatus   @default(Tercatat)
  createdAt   DateTime         @default(now()) @map("created_at")

  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([catId])
  @@index([eventDate(sort: Desc)])
  @@map("timeline_events")
}

// ─────────────────────────────────────────────
// ACHIEVEMENTS (Galeri Prestasi)
// ─────────────────────────────────────────────
model Achievement {
  id          String   @id @default(uuid())
  catId       String   @map("cat_id")
  title       String   @db.VarChar(160)
  description String?  @db.Text
  achievedAt  DateTime @map("achieved_at") @db.Date
  rank        Int? // lower = more important; used to pick the top achievements
  icon        String?  @default("trophy") // lucide icon name
  createdAt   DateTime @default(now()) @map("created_at")

  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([catId])
  @@map("achievements")
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────
model Product {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(160)
  category    String?  @db.VarChar(60)
  priceIdr    Decimal  @map("price_idr") @db.Decimal(12, 2)
  reason      String?  @db.Text
  description String?  @db.Text
  badge       String?  @db.VarChar(60)
  imageUrl    String?  @map("image_url")
  stock       Int?     @default(0) @map("stock")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tags                   ProductTag[]
  recommendationFeedback RecommendationFeedback[]

  @@index([category])
  @@index([isActive])
  @@map("products")
}

model ProductTag {
  id        String @id @default(uuid())
  productId String @map("product_id")
  tag       String @db.VarChar(60)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([tag])
  @@map("product_tags")
}

// ─────────────────────────────────────────────
// RECOMMENDATION FEEDBACK
// ─────────────────────────────────────────────
enum RecommendationType {
  product
  article
  care_action
}

enum RecommendationResponse {
  liked
  disliked
  not_tried
  caused_issue
  saved
}

model RecommendationFeedback {
  id                 String                 @id @default(uuid())
  userId             String                 @map("user_id")
  catId              String                 @map("cat_id")
  productId          String?                @map("product_id")
  recommendationType RecommendationType     @default(product) @map("recommendation_type")
  response           RecommendationResponse
  note               String?                @db.Text
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cat     Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, catId, productId, recommendationType])
  @@index([catId, recommendationType])
  @@index([productId])
  @@map("recommendation_feedback")
}

// ─────────────────────────────────────────────
// ORDERS (checkout history via WhatsApp)
// ─────────────────────────────────────────────
model Order {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  total     Decimal  @db.Decimal(12, 2)
  status    String   @default("Menunggu") @db.VarChar(40) // Menunggu | Dikonfirmasi | Selesai | Batal
  channel   String?  @default("WhatsApp") @map("channel") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at")

  items OrderItem[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String? @map("product_id")
  name      String  @db.VarChar(200)
  price     Decimal @db.Decimal(12, 2)
  quantity  Int
  subtotal  Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────────────────────
// ARTICLES
// ─────────────────────────────────────────────
model Article {
  id         String   @id @default(uuid())
  slug       String   @unique @db.VarChar(160)
  title      String   @db.VarChar(255)
  category   String?  @db.VarChar(60)
  readTime   String?  @map("read_time") @db.VarChar(20)
  summary    String?  @db.Text
  heroImage  String?  @map("hero_image")
  vetWarning String?  @map("vet_warning") @db.Text
  breedId    String?  @map("breed_id")
  author     String?  @db.VarChar(120)
  sourceUrl  String?  @map("source_url") @db.VarChar(500)
  updatedAt  DateTime @updatedAt @map("updated_at")

  breed     CatBreed?         @relation(fields: [breedId], references: [id], onDelete: SetNull)
  sections  ArticleSection[]
  takeaways ArticleTakeaway[]

  @@map("articles")
}

model ArticleSection {
  id        String @id @default(uuid())
  articleId String @map("article_id")
  heading   String @db.VarChar(160)
  body      String @db.Text
  sortOrder Int    @default(0) @map("sort_order")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_sections")
}

model ArticleTakeaway {
  id        String @id @default(uuid())
  articleId String @map("article_id")
  point     String @db.Text
  sortOrder Int    @default(0) @map("sort_order")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_takeaways")
}

// ─────────────────────────────────────────────
// EVENTS (Event Anabul — cat shows, clinics, etc.)
// ─────────────────────────────────────────────
model Event {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(200)
  type        String   @db.VarChar(80) // "Pameran & Kompetisi" | "Edukasi & Kesehatan" | "Adopsi" | "Kompetisi"
  eventDate   DateTime @map("event_date") @db.Date
  location    String   @db.VarChar(160)
  description String?  @db.Text
  sourceUrl   String?  @map("source_url") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([eventDate])
  @@index([isActive])
  @@map("events")
}

// ─────────────────────────────────────────────
// CHAT MESSAGES (Ketty AI history)
// ─────────────────────────────────────────────
enum ChatRole {
  user
  assistant
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  catId     String?  @map("cat_id")
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cat  Cat? @relation(fields: [catId], references: [id], onDelete: SetNull)

  @@index([userId, catId])
  @@index([createdAt(sort: Desc)])
  @@map("chat_messages")
}
